---
import { getCollection } from 'astro:content';
import Layout from '@components/Layout.astro';
import UsMap from '@components/UsMap.astro';
import BandKey from '@components/BandKey.astro';
import BandColumns from '@components/BandColumns.astro';

const locations = (await getCollection('locations')).sort((a, b) =>
  a.data.location.localeCompare(b.data.location)
);
---

<Layout title="How's Pot Doing?" current="home">
  <div class="hero">
    <div class="intro">
      <h1>Is pot legal where you are?</h1>
      <p class="lede">
        Check cannabis legality by state using official government sources. We score recreational
        and medical access plus buying and home grow so you see what's allowed.
      </p>
    </div>
    <div class="map">
      <UsMap locations={locations} />
      <BandKey />
    </div>
  </div>
  <section class="bands">
    <h2 id="after-map" tabindex="-1">Cannabis is …</h2>
    <BandColumns locations={locations} />
  </section>
</Layout>

<style>
  h1 {
    font-size: 26px;
    margin: 0 0 10px;
  }
  .lede {
    margin: 0 0 16px;
    color: var(--fg);
  }
  .map :global(.key) {
    margin: 6px 0 22px;
  }
  .bands {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 2px solid var(--fg);
  }
  .bands h2 {
    font-size: 18px;
    margin: 0 0 18px;
  }
  .bands h2:focus {
    outline: none;
  }
  @media (min-width: 768px) {
    h1 {
      font-size: 28px;
    }
  }
  @media (min-width: 1024px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 40px;
      align-items: start;
    }
    .intro {
      order: 2;
    }
    .map {
      order: 1;
    }
    h1 {
      font-size: 30px;
      margin-bottom: 12px;
    }
    .lede {
      color: var(--muted);
      margin-bottom: 0;
    }
    .map :global(.key) {
      margin: 8px 0 0;
    }
    .bands {
      margin-top: 36px;
      padding-top: 36px;
    }
    .bands h2 {
      font-size: 20px;
    }
  }
</style>
