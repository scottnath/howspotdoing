---
import type { CollectionEntry } from 'astro:content';
import Question from '@components/Question.astro';
import Badge from '@components/Badge.astro';
import StateMarks from '@components/StateMarks.astro';
import { shortDate } from '../utils/marks';

export interface Props {
  location: CollectionEntry<'locations'>;
  prev: { name: string; slug: string };
  next: { name: string; slug: string };
}
const { location, prev, next } = Astro.props;
const d = location.data;
const host = d.primaryGovUrl
  ? d.primaryGovUrl.replace(/^https?:\/\//, '').replace(/^www\./, '').split('/')[0]
  : '';
const reviewed = shortDate(d.lastResearchISO);
---

<article itemscope itemtype="https://schema.org/FAQPage">
  <div class="top">
    <nav class="prevnext" aria-label="Other states">
      <a href={`/locations/${prev.slug}/`}>← {prev.name}</a>
      <a href={`/locations/${next.slug}/`}>{next.name} →</a>
    </nav>
    <header class="verdict">
      <p class="is">Cannabis is</p>
      <Badge score={d.legality} size={150} class="badge-p" />
      <Badge score={d.legality} size={200} class="badge-d" />
      <h1 itemprop="name"><span class="in">in</span> {d.location}</h1>
      <p class="meta">
        Reviewed <time datetime={d.lastResearchISO}>{reviewed}</time>
        {d.primaryGovUrl && (<> · Official info: <a href={d.primaryGovUrl}>{host}</a></>)}
      </p>
    </header>
    <StateMarks answers={d.answers} />
  </div>

  <section class="qs">
    <div>
      <h2>Recreational</h2>
      <Question report={d.results.RECREATIONAL} />
      <Question report={d.results.RECREATIONAL_STORE} />
      <Question report={d.results.RECREATIONAL_GROW} />
      <Question report={d.results.RECREATIONAL_PUBLIC} />
      <Question report={d.results.RECREATIONAL_ONSITE} />
    </div>
    <div>
      <h2>Medical</h2>
      <Question report={d.results.MEDICAL} />
      <Question report={d.results.MEDICAL_STORE} />
      <Question report={d.results.MEDICAL_GROW} />
    </div>
  </section>

  <p class="foot">
    Quotes are from the state's own .gov pages. How the score works is on the <a href="/about/">about</a> page.
  </p>
</article>

<style>
  .prevnext {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 600;
  }
  .prevnext a {
    color: var(--link);
    text-decoration: none;
    padding: 6px 0;
  }
  .verdict {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    margin: 14px 0 6px;
  }
  .is {
    font-size: 18px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: -2px;
  }
  .verdict :global(.badge-d) {
    display: none;
  }
  h1 {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 10px;
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .in {
    font-size: 18px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0;
  }
  .meta {
    font-size: 14px;
    color: var(--muted);
    margin-top: 14px;
    text-align: center;
  }
  .meta a {
    color: var(--link);
  }
  h2 {
    font-size: 20px;
    font-weight: 800;
    margin: 28px 0 4px;
  }
  .foot {
    font-size: 13px;
    color: var(--muted);
    text-align: center;
    margin-top: 20px;
  }
  @media (min-width: 1024px) {
    .top {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 0 48px;
      align-items: start;
    }
    .prevnext,
    .verdict {
      grid-column: 1;
    }
    .top :global(.marks) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .verdict {
      gap: 20px;
      margin: 16px 0 6px;
    }
    .is {
      font-size: 24px;
      margin-bottom: 0;
    }
    .verdict :global(.badge-p) {
      display: none;
    }
    .verdict :global(.badge-d) {
      display: inline-flex;
    }
    h1 {
      font-size: 56px;
      line-height: 1;
      gap: 14px;
    }
    .in {
      font-size: 24px;
    }
    .qs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 48px;
      align-items: start;
      margin-top: 40px;
      padding-top: 32px;
      border-top: 2px solid var(--fg);
    }
    h2 {
      font-size: 22px;
      margin: 0 0 4px;
    }
    .foot {
      margin-top: 28px;
    }
  }
</style>
