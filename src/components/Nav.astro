---
export type Current = 'home' | 'about' | 'locations';
export interface Props {
  current?: Current;
}
const { current } = Astro.props;
const items: { key: Current; href: string; label: string }[] = [
  { key: 'home', href: '/', label: 'home' },
  { key: 'about', href: '/about/', label: 'about' },
  { key: 'locations', href: '/locations/', label: 'locations' },
];
---

<nav aria-label="Site">
  {
    items.map((item) => (
      <a
        href={item.href}
        aria-current={item.key === current ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))
  }
</nav>

<style>
  nav {
    display: flex;
    gap: 24px;
  }
  a {
    font-weight: 600;
    text-decoration: none;
    padding: 8px 0;
    color: var(--link);
  }
  a[aria-current='page'] {
    color: var(--fg);
    border-bottom: 2px solid var(--fg);
  }
</style>
